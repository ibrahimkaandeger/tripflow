# --- Server ---
PORT=5000
NODE_ENV=development
# Allowed browser origin(s) for CORS, comma-separated.
CLIENT_URL=http://localhost:5173

# --- Database ---
# Either a single connection string (takes precedence) ...
DATABASE_URL=
# ... or the discrete settings below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripflow_db
DB_USER=postgres
DB_PASSWORD=

# --- Auth ---
# Long random value, at least 32 characters (required in production), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
