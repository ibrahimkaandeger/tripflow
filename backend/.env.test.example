# Used only by `npm test`. DB_NAME must be exactly tripflow_test -- the
# test helpers refuse to run against any other database, and
# DATABASE_URL must NOT be set here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripflow_test
DB_USER=postgres
DB_PASSWORD=

# Any long random value (different from the development secret).
JWT_SECRET=

NODE_ENV=test
